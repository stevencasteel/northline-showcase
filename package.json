{
  "name": "northline-roofing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convert-avif": "node scripts/convert-avif.js",
    "images:webp": "node scripts/generate-responsive-webp.js",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && prettier --check package.json eslint.config.js",
    "format": "prettier --write package.json eslint.config.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.28.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "image-size": "2.0.2",
    "prettier": "3.6.2",
    "sharp": "0.35.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vite": "8.1.5"
  }
}
